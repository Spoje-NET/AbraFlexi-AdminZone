{
  "name": "vitexsoftware/abraflexi-adminzone",
  "description": "Administrátorská zóna pro AbraFlexi: správa zákazníků, fakturace, importy a integrace",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Vítězslav Dvořák",
      "email": "vitex@arachne.cz"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-curl": "*",
    "spojenet/flexibee": "^3.7",
    "vitexsoftware/ease-core": "^1.50",
    "vitexsoftware/abraflexi-bricks": ">=1.5.0",
    "vitexsoftware/ease-bootstrap5-widgets-abraflexi": "^1.4",
    "vitexsoftware/ease-html-widgets": "dev-main",
    "vitexsoftware/datatables-abraflexi": "^1.2",
    "spojenet/subreg": "dev-main",
    "spojenet/ipexb2b": "dev-main",
    "mpdf/mpdf": "*",
    "mhujer/fio-api-php": "^2.4",
    "vitexsoftware/ease-twbootstrap5": ">=1.2.0"
  },
  "autoload": {
    "psr-4": {
      "AdminZone\\": "src/AdminZone/",
      "AdminZone\\ui\\": "src/AdminZone/ui/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\AdminZone\\": "tests/src/AdminZone/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "phpstan/phpstan": "*"
  }
}
