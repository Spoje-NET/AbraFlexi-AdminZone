#!/usr/bin/make -f

PKG_ROOT := debian/abraflexi-adminzone/usr/share/abraflexi-adminzone

%:
	dh $@

override_dh_auto_test:
	appstreamcli validate --pedantic --no-net \
	    debian/io.github.spoje_net.abraflexi-adminzone.metainfo.xml

override_dh_install:
	# core without the service extensions, they have their own packages
	dh_install -pabraflexi-adminzone \
	    -Xsrc/ipex.php -Xsrc/subreg.php -Xsrc/adr2subreg.php \
	    -Xsrc/sledovanitv.php -Xsrc/sltvregister.php
	dh_install -pabraflexi-adminzone-ipex -pabraflexi-adminzone-subreg -pabraflexi-adminzone-sledovanitv
	# stock icon referenced by the AppStream metadata
	install -D -m 0644 src/images/logo.svg \
	    debian/abraflexi-adminzone/usr/share/icons/hicolor/scalable/apps/abraflexi-adminzone.svg
	# Rewrite development paths to Debian install locations
	sed -i \
	    -e "s|__DIR__ . '/../../vendor/autoload.php'|'/usr/share/abraflexi-adminzone/autoload.php'|" \
	    -e "s|__DIR__ . '/../../i18n'|'/usr/share/locale'|" \
	    -e "s|__DIR__ . '/../../.env'|'/etc/abraflexi-admin-zone/.env'|" \
	    -e "s|__DIR__ . '/../../conf.d|'/etc/abraflexi-admin-zone/conf.d|" \
	    $(PKG_ROOT)/includes/Init.php
	find $(PKG_ROOT) -name '*.php' -print0 | xargs -0 sed -i \
	    -e "s|require_once __DIR__ *\. *'/../vendor/autoload.php';|require_once '/usr/share/abraflexi-adminzone/autoload.php';|g" \
	    -e "s|require_once '../vendor/autoload.php';|require_once '/usr/share/abraflexi-adminzone/autoload.php';|g"
