src/*.php			usr/share/abraflexi-adminzone
src/*.ico			usr/share/abraflexi-adminzone
src/robots.txt			usr/share/abraflexi-adminzone
src/includes/*.php		usr/share/abraflexi-adminzone/includes
src/css/*.css			usr/share/abraflexi-adminzone/css
src/js/*			usr/share/abraflexi-adminzone/js
src/images/*			usr/share/abraflexi-adminzone/images
src/assets/*			usr/share/abraflexi-adminzone/assets
src/AdminZone/*.php		usr/share/abraflexi-adminzone/AdminZone
src/AdminZone/ui/*.php		usr/share/abraflexi-adminzone/AdminZone/ui
