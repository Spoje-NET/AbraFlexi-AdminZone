#!/bin/sh
# debconf configuration for abraflexi-adminzone-subreg

set -e
. /usr/share/debconf/confmodule

db_input high "adminzone/SUBREG_LOCATION" || true
db_go || true
db_input high "adminzone/SUBREG_URI" || true
db_go || true
db_input high "adminzone/SUBREG_LOGIN" || true
db_go || true
db_input high "adminzone/SUBREG_PASSWORD" || true
db_go || true

exit 0
