# AdminZone configuration template
# (installed package: copy to /etc/abraflexi-admin-zone/.env)

# AbraFlexi server; operators sign in with their own AbraFlexi account
ABRAFLEXI_URL=https://demo.flexibee.eu:5434
ABRAFLEXI_COMPANY=demo
# The certificate is verified by default. For a self-signed server prefer
# trusting its certificate over disabling verification:
#ABRAFLEXI_CA_FILE=/etc/ssl/certs/abraflexi-ca.pem
#ABRAFLEXI_VERIFY_SSL=false

# IPEX B2B API
IPEX_URL=https://restapi.ipex.cz
IPEX_LOGIN=
IPEX_PASSWORD=

# Subreg SOAP API
SUBREG_LOCATION=https://ote-soap.subreg.cz/cmd.php
SUBREG_URI=https://ote-soap.subreg.cz/soap
SUBREG_LOGIN=
SUBREG_PASSWORD=

# SledovaniTV partner API
SLTV_LOGIN=
SLTV_PASSWORD=

# Show exception details on the error page (development only)
#APP_DEBUG=false
