#!/bin/sh
# postinst script for abraflexi-adminzone-ipex
# Writes the credentials to a drop-in file read by AdminZone Init.

set -e
. /usr/share/debconf/confmodule

ENV_DIR="/etc/abraflexi-admin-zone"
CONF_FILE="${ENV_DIR}/conf.d/ipex.env"
CORE_ENV="${ENV_DIR}/.env"

case "$1" in
    configure)
        install -d -m 0750 -o root -g www-data "$ENV_DIR" "${ENV_DIR}/conf.d"
        {
            echo "# Generated by abraflexi-adminzone-ipex package"
            db_get "adminzone/IPEX_URL" || true
            printf 'IPEX_URL="%s"\n' "$RET"
            db_get "adminzone/IPEX_LOGIN" || true
            printf 'IPEX_LOGIN="%s"\n' "$RET"
            db_get "adminzone/IPEX_PASSWORD" || true
            printf 'IPEX_PASSWORD="%s"\n' "$RET"
        } > "$CONF_FILE"
        chown root:www-data "$CONF_FILE"
        chmod 0640 "$CONF_FILE"

        # Values moved here from the core .env (before AdminZone 0.3.0)
        if [ -f "$CORE_ENV" ]; then
            for key in IPEX_URL IPEX_LOGIN IPEX_PASSWORD; do
                sed -i "/^${key}=/d" "$CORE_ENV"
            done
        fi
        ;;
esac

#DEBHELPER#

exit 0
