#!/bin/sh
# postinst script for abraflexi-adminzone-subreg
# Writes the credentials to a drop-in file read by AdminZone Init.

set -e
. /usr/share/debconf/confmodule

ENV_DIR="/etc/abraflexi-admin-zone"
CONF_FILE="${ENV_DIR}/conf.d/subreg.env"
CORE_ENV="${ENV_DIR}/.env"

case "$1" in
    configure)
        install -d -m 0750 -o root -g www-data "$ENV_DIR" "${ENV_DIR}/conf.d"
        {
            echo "# Generated by abraflexi-adminzone-subreg package"
            db_get "adminzone/SUBREG_LOCATION" || true
            printf 'SUBREG_LOCATION="%s"\n' "$RET"
            db_get "adminzone/SUBREG_URI" || true
            printf 'SUBREG_URI="%s"\n' "$RET"
            db_get "adminzone/SUBREG_LOGIN" || true
            printf 'SUBREG_LOGIN="%s"\n' "$RET"
            db_get "adminzone/SUBREG_PASSWORD" || true
            printf 'SUBREG_PASSWORD="%s"\n' "$RET"
        } > "$CONF_FILE"
        chown root:www-data "$CONF_FILE"
        chmod 0640 "$CONF_FILE"

        # Values moved here from the core .env (before AdminZone 0.3.0)
        if [ -f "$CORE_ENV" ]; then
            for key in SUBREG_LOCATION SUBREG_URI SUBREG_LOGIN SUBREG_PASSWORD; do
                sed -i "/^${key}=/d" "$CORE_ENV"
            done
        fi
        ;;
esac

#DEBHELPER#

exit 0
